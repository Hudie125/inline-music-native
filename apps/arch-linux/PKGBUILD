# Maintainer: inline Music Contributors <kronyxxbezdar@gmail.com>
pkgname=inline-music
pkgver=0.1.0
pkgrel=1
pkgdesc="Free, open-source native music player for Arch Linux (C++20, Qt 6 QML, GStreamer, MPRIS)"
arch=('x86_64')
url="https://github.com/Hudie125/inline-music-native"
license=('MIT')
depends=(
    'qt6-base'
    'qt6-declarative'
    'qt6-shadertools'
    'gstreamer'
    'gst-plugins-base'
    'gst-plugins-good'
    'gst-plugins-bad'
    'sqlite'
    'hicolor-icon-theme'
)
makedepends=(
    'cmake'
    'ninja'
    'pkgconf'
    'gcc'
)
source=()
sha256sums=()

build() {
    cmake -B "$srcdir/build" -S "$startdir" \
        -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build "$srcdir/build"
}

check() {
    ctest --test-dir "$srcdir/build" --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
    if [ -f "$startdir/../../LICENSE" ]; then
        install -Dm644 "$startdir/../../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi
}
