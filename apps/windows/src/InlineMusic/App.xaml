<Application x:Class="InlineMusic.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Monochrome Design System Palette -->
            <SolidColorBrush x:Key="CanvasBackground" Color="#000000" />
            <SolidColorBrush x:Key="SurfaceGlass" Color="#18181C" Opacity="0.75" />
            <SolidColorBrush x:Key="SurfaceGlassHover" Color="#28282E" Opacity="0.85" />
            <SolidColorBrush x:Key="GlassBorder" Color="#30FFFFFF" />
            <SolidColorBrush x:Key="GlassBorderSubtle" Color="#15FFFFFF" />
            <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondary" Color="#8E8E93" />
            <SolidColorBrush x:Key="TextTertiary" Color="#48484A" />

            <!-- Global Glass Card Style -->
            <Style x:Key="GlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceGlass}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassBorderSubtle}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
