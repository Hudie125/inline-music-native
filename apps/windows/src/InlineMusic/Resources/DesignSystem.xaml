<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- 1. COLOR TOKENS (Liquid Glass Monochrome & Slate Atmosphere)              -->
    <!-- ========================================================================= -->
    <Color x:Key="ColorCanvas">#09090B</Color>
    <Color x:Key="ColorSidebar">#0C0C0E</Color>
    <Color x:Key="ColorSurfaceGlassTop">#22222A</Color>
    <Color x:Key="ColorSurfaceGlassBottom">#101014</Color>
    <Color x:Key="ColorBorderSpecularTop">#3AFFFFFF</Color>
    <Color x:Key="ColorBorderSpecularBottom">#0AFFFFFF</Color>
    <Color x:Key="ColorTextPrimary">#FFFFFF</Color>
    <Color x:Key="ColorTextSecondary">#A1A1AA</Color>
    <Color x:Key="ColorTextTertiary">#52525B</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource ColorCanvas}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource ColorSidebar}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource ColorTextTertiary}" />
    <SolidColorBrush x:Key="AccentHeartBrush" Color="#F43F5E" />

    <!-- Frosted Glass Surface Background -->
    <LinearGradientBrush x:Key="LiquidGlassSurface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1E1E26" Offset="0.0" />
        <GradientStop Color="#121216" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Glass Specular Border -->
    <LinearGradientBrush x:Key="LiquidGlassBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#38FFFFFF" Offset="0.0" />
        <GradientStop Color="#12FFFFFF" Offset="0.4" />
        <GradientStop Color="#06FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Elevated Dark Glass -->
    <SolidColorBrush x:Key="ElevatedGlass" Color="#16161B" Opacity="0.92" />
    <SolidColorBrush x:Key="HoverGlass" Color="#262630" Opacity="0.95" />
    <SolidColorBrush x:Key="ActiveGlass" Color="#323240" Opacity="0.98" />

