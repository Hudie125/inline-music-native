<UserControl x:Class="InlineMusic.Views.EqualizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header & Presets -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Equalizer &amp; Effects" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" />
                <TextBlock Text="10-band IIR biquad acoustic tuning &amp; real crossfade" FontSize="14" Foreground="#8E8E93" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" Width="160" Margin="0,0,12,0" />
                <Button Content="Reset" Command="{Binding ResetCommand}" Padding="16,8" />
            </StackPanel>
        </Grid>

        <!-- Crossfade Configuration Card -->
        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="24,18" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Audio Crossfade" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="15" />
                    <TextBlock Text="Equal-power seamless blend" Foreground="#8E8E93" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>

                <Slider Grid.Column="1" Minimum="0" Maximum="12" Value="{Binding CrossfadeDuration}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="16,0" />
                <TextBlock Grid.Column="2" Text="{Binding CrossfadeDuration, StringFormat='{}{0:0.0}s'}" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- 10-Band Sliders Grid -->
        <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 32 Hz -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="+12dB" Foreground="#48484A" FontSize="10" HorizontalAlignment="Center" />
                    <Slider Orientation="Vertical" Height="220" Minimum="-12" Maximum="12" Value="0" ValueChanged="Slider_ValueChanged" Tag="0" Margin="0,8" />
                    <TextBlock Text="32Hz" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 64 Hz -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="+12dB" Foreground="#48484A" FontSize="10" HorizontalAlignment="Center" />
                    <Slider Orientation="Vertical" Height="220" Minimum="-12" Maximum="12" Value="0" ValueChanged="Slider_ValueChanged" Tag="1" Margin="0,8" />
                    <TextBlock Text="64Hz" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 125 Hz -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="+12dB" Foreground="#48484A" FontSize="10" HorizontalAlignment="Center" />
                    <Slider Orientation="Vertical" Height="220" Minimum="-12" Maximum="12" Value="0" ValueChanged="Slider_ValueChanged" Tag="2" Margin="0,8" />
                    <TextBlock Text="125Hz" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 250 Hz -->
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="+12dB" Foreground="#48484A" FontSize="10" HorizontalAlignment="Center" />
                    <Slider Orientation="Vertical" Height="220" Minimum="-12" Maximum="12" Value="0" ValueChanged="Slider_ValueChanged" Tag="3" Margin="0,8" />
                    <TextBlock Text="250Hz" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 500 Hz -->
                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock Text="+12dB" Foreground="#48484A" FontSize="10" HorizontalAlignment="Center" />
                    <Slider Orientation="Vertical" Height="220" Minimum="-12" Maximum="12" Value="0" ValueChanged="Slider_ValueChanged" Tag="4" Margin="0,8" />
                    <TextBlock Text="500Hz" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 1 kHz -->
                <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                    <TextBlock Text="+12dB" Foreground="#48484A" FontSize="10" HorizontalAlignment="Center" />
                    <Slider Orientation="Vertical" Height="220" Minimum="-12" Maximum="12" Value="0" ValueChanged="Slider_ValueChanged" Tag="5" Margin="0,8" />
                    <TextBlock Text="1kHz" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 2 kHz -->
                <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                    <TextBlock Text="+12dB" Foreground="#48484A" FontSize="10" HorizontalAlignment="Center" />
                    <Slider Orientation="Vertical" Height="220" Minimum="-12" Maximum="12" Value="0" ValueChanged="Slider_ValueChanged" Tag="6" Margin="0,8" />
                    <TextBlock Text="2kHz" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 4 kHz -->
                <StackPanel Grid.Column="7" HorizontalAlignment="Center">
                    <TextBlock Text="+12dB" Foreground="#48484A" FontSize="10" HorizontalAlignment="Center" />
                    <Slider Orientation="Vertical" Height="220" Minimum="-12" Maximum="12" Value="0" ValueChanged="Slider_ValueChanged" Tag="7" Margin="0,8" />
                    <TextBlock Text="4kHz" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 8 kHz -->
                <StackPanel Grid.Column="8" HorizontalAlignment="Center">
                    <TextBlock Text="+12dB" Foreground="#48484A" FontSize="10" HorizontalAlignment="Center" />
                    <Slider Orientation="Vertical" Height="220" Minimum="-12" Maximum="12" Value="0" ValueChanged="Slider_ValueChanged" Tag="8" Margin="0,8" />
                    <TextBlock Text="8kHz" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 16 kHz -->
                <StackPanel Grid.Column="9" HorizontalAlignment="Center">
                    <TextBlock Text="+12dB" Foreground="#48484A" FontSize="10" HorizontalAlignment="Center" />
                    <Slider Orientation="Vertical" Height="220" Minimum="-12" Maximum="12" Value="0" ValueChanged="Slider_ValueChanged" Tag="9" Margin="0,8" />
                    <TextBlock Text="16kHz" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
