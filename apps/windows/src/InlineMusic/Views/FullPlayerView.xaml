<UserControl x:Class="InlineMusic.Views.FullPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="32,24,32,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: Large Artwork & Controls -->
        <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="32" Margin="0,0,24,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Large Album Artwork -->
                <Border Grid.Row="0" Width="320" Height="320" CornerRadius="20" Background="#1C1C1E" ClipToBounds="True" HorizontalAlignment="Center">
                    <Image Source="{Binding CurrentTrack.CoverPath}" Stretch="UniformToFill" />
                </Border>

                <!-- Title & Artist -->
                <StackPanel Grid.Row="1" Margin="0,24,0,20" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='No Track Playing'}" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CurrentTrack.Artist, FallbackValue='Select music to begin'}" FontSize="15" Foreground="#8E8E93" Margin="0,6,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Action Controls (Shuffle, Previous, Play/Pause, Next, Repeat) -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="🔀" Command="{Binding ToggleShuffleCommand}" Width="44" Height="44" Margin="6,0" />
                    <Button Content="⏮" Command="{Binding PreviousCommand}" Width="48" Height="48" Margin="6,0" FontSize="18" />
                    <Button Content="⏯" Command="{Binding PlayPauseCommand}" Width="56" Height="56" Margin="8,0" Background="#FFFFFF" Foreground="#000000" FontSize="20" FontWeight="Bold" />
                    <Button Content="⏭" Command="{Binding NextCommand}" Width="48" Height="48" Margin="6,0" FontSize="18" />
                    <Button Content="🔁" Command="{Binding CycleRepeatCommand}" Width="44" Height="44" Margin="6,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right: Synchronized Lyrics / Karaoke Column -->
        <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Synchronized Lyrics" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16" />

                <!-- Lyrics Auto-scrolling List -->
                <ListBox Grid.Row="1" ItemsSource="{Binding Lyrics}" SelectedItem="{Binding ActiveLyricsLine}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" FontSize="18" Margin="0,8" TextWrapping="Wrap"
                                       Foreground="#8E8E93" FontWeight="Normal">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="FontSize" Value="22" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
