<UserControl x:Class="InlineMusic.Views.FullPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="32,24,32,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: Large Artwork, Metadata & Extended Controls -->
        <Border Grid.Column="0" Style="{StaticResource ModernGlassCard}" Padding="32" Margin="0,0,24,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Album Artwork with Depth Shadow -->
                <Border Grid.Row="0" Width="300" Height="300" CornerRadius="20" Background="#16161B" BorderBrush="#25FFFFFF" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="32" ShadowDepth="6" Color="#000000" Opacity="0.6" />
                    </Border.Effect>
                    <Grid>
                        <Path Data="{StaticResource IconLibrary}" Fill="#2A2A32" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding CurrentTrack.CoverPath}" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <!-- Title & Artist -->
                <StackPanel Grid.Row="1" Margin="0,28,0,24" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='No Track Playing'}" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                    <TextBlock Text="{Binding CurrentTrack.Artist, FallbackValue='Select music to begin'}" FontSize="15" Foreground="#A1A1AA" Margin="0,6,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                </StackPanel>

                <!-- Action Controls (Shuffle, Previous, Play/Pause, Next, Repeat) -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Shuffle -->
                    <Button Style="{StaticResource GlassIconButton}" Command="{Binding ToggleShuffleCommand}" Width="40" Height="40" Margin="6,0" ToolTip="Shuffle">
                        <Path Data="{StaticResource IconShuffle}" Fill="#71717A" Width="16" Height="16" Stretch="Uniform" />
                    </Button>

                    <!-- Previous -->
                    <Button Style="{StaticResource GlassIconButton}" Command="{Binding PreviousCommand}" Width="44" Height="44" Margin="6,0" ToolTip="Previous Track">
                        <Path Data="{StaticResource IconPrevious}" Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" />
                    </Button>

                    <!-- Hero Play / Pause -->
                    <Button Style="{StaticResource HeroPlayButton}" Command="{Binding PlayPauseCommand}" Width="56" Height="56" Margin="10,0" ToolTip="Play / Pause">
                        <Path Width="18" Height="18" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource IconPlay}" />
                                    <Setter Property="Fill" Value="#09090B" />
                                    <Setter Property="Margin" Value="2,0,0,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource IconPause}" />
                                            <Setter Property="Margin" Value="0,0,0,0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <!-- Next -->
                    <Button Style="{StaticResource GlassIconButton}" Command="{Binding NextCommand}" Width="44" Height="44" Margin="6,0" ToolTip="Next Track">
                        <Path Data="{StaticResource IconNext}" Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" />
                    </Button>

                    <!-- Repeat -->
                    <Button Style="{StaticResource GlassIconButton}" Command="{Binding CycleRepeatCommand}" Width="40" Height="40" Margin="6,0" ToolTip="Repeat">
                        <Path Data="{StaticResource IconRepeat}" Fill="#71717A" Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right Column: Synchronized Apple-style Lyrics -->
        <Border Grid.Column="1" Style="{StaticResource ModernGlassCard}" Padding="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Lyrics Header -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Synchronized Lyrics" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                    <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="12" Padding="10,4">
                        <TextBlock Text="LRCLIB • Live Sync" Foreground="#A1A1AA" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <!-- Lyrics Auto-scrolling List -->
                <ListBox Grid.Row="1" ItemsSource="{Binding Lyrics}" SelectedItem="{Binding ActiveLyricsLine}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,4" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" FontSize="18" Margin="0,10" TextWrapping="Wrap"
                                       Foreground="#52525B" FontWeight="Medium" FontFamily="Segoe UI Variable, Segoe UI, sans-serif">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="FontSize" Value="24" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#FFFFFF" Opacity="0.35" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
