<ui:FluentWindow x:Class="InlineMusic.Views.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:views="clr-namespace:InlineMusic.Views"
                  xmlns:vm="clr-namespace:InlineMusic.ViewModels"
                  Title="inline"
                  Width="1200" Height="780"
                  MinWidth="960" MinHeight="620"
                  WindowStartupLocation="CenterScreen"
                  WindowBackdropType="Mica"
                  ExtendsContentIntoTitleBar="True"
                  Background="#000000">

    <Grid Background="#000000">
        <!-- Main Application Shell -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="84" />
            </Grid.RowDefinitions>

            <!-- Custom WinUI 3 TitleBar -->
            <ui:TitleBar Grid.Row="0" Title="inline" ShowMaximize="True" ShowMinimize="True" Height="36" />

            <!-- Body Grid: Sidebar Navigation + Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar Navigation -->
                <Border Grid.Column="0" Background="#0C0C0E" BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0" Padding="16,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Brand Logo & Title -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,0,0,28">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#1C1C22" BorderBrush="#30FFFFFF" BorderThickness="1">
                                <TextBlock Text="..." Foreground="#FFFFFF" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-6,0,0" />
                            </Border>
                            <TextBlock Text="inline" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>

                        <!-- Navigation Items -->
                        <StackPanel Grid.Row="1">
                            <Button Content="🎵  Library" Command="{Binding NavigateLibraryCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="14" />
                            <Button Content="🔍  Search" Command="{Binding NavigateSearchCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="14" />
                            <Button Content="🌊  My Wave" Command="{Binding NavigateWaveCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="14" />
                            <Button Content="🎚️  Equalizer" Command="{Binding NavigateEqualizerCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="14" />
                            <Button Content="⚙️  Settings" Command="{Binding NavigateSettingsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="14" />
                        </StackPanel>

                        <!-- Mini Player Toggle -->
                        <Button Grid.Row="2" Content="Mini Player" Command="{Binding ToggleMiniPlayerCommand}" HorizontalAlignment="Stretch" Padding="12,8" />
                    </Grid>
                </Border>

                <!-- Center Content Area -->
                <Grid Grid.Column="1">
                    <ContentControl Content="{Binding CurrentView}">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
                                <views:HomeView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:SearchViewModel}">
                                <views:SearchView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:WaveViewModel}">
                                <views:WaveView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:EqualizerViewModel}">
                                <views:EqualizerView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                                <views:SettingsView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:PlayerViewModel}">
                                <views:FullPlayerView />
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </Grid>
            </Grid>

            <!-- Bottom Liquid Glass Player Bar -->
            <Border Grid.Row="2" Background="#141418" BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0" Padding="20,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Artwork & Now Playing Info -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="10" Background="#28282E" ClipToBounds="True">
                            <Image Source="{Binding CurrentTrack.CoverPath}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='inline Music'}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                            <TextBlock Text="{Binding CurrentTrack.Artist, FallbackValue='Ready'}" Foreground="#8E8E93" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                        </StackPanel>
                        <Button Content="♡" Command="{Binding ToggleLikeCommand}" Width="32" Height="32" Margin="8,0,0,0" Background="Transparent" Foreground="#8E8E93" BorderThickness="0" FontSize="16" />
                    </StackPanel>

                    <!-- Center: Playback Controls & Progress Scrubber -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Width="460">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <Button Content="⏮" Command="{Binding PreviousCommand}" Width="36" Height="36" Margin="6,0" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="14" />
                            <Button Content="⏯" Command="{Binding TogglePlayPauseCommand}" Width="44" Height="44" Margin="8,0" Background="#FFFFFF" Foreground="#000000" FontWeight="Bold" FontSize="16" />
                            <Button Content="⏭" Command="{Binding NextCommand}" Width="36" Height="36" Margin="6,0" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="14" />
                        </StackPanel>

                        <!-- Timeline Scrubber -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding CurrentPosition, StringFormat='{}{0:m\\:ss}'}" Foreground="#8E8E93" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}" Margin="8,0" Height="18" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Duration, StringFormat='{}{0:m\\:ss}'}" Foreground="#8E8E93" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <!-- Right: Volume & Expand Fullscreen Player -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="🔊" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider Width="90" Minimum="0" Maximum="1" Value="{Binding Volume}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Button Content="⛶" Command="{Binding ToggleFullPlayerCommand}" Width="36" Height="36" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" ToolTip="Fullscreen Lyrics" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Animated Welcome Screen Overlay (Section 4.6) -->
        <Grid x:Name="WelcomeOverlay" Background="#000000" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="WelcomeText" Text="welcome" FontSize="44" FontWeight="SemiBold" Foreground="#FFFFFF" Opacity="0" HorizontalAlignment="Center" />
                <Button Content="Enter inline" Margin="0,32,0,0" Padding="28,10" Background="#FFFFFF" Foreground="#000000" FontWeight="Bold" Click="EnterApp_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
