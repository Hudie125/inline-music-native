<Window x:Class="InlineMusic.Views.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="inline Mini Player"
        Width="380" Height="96"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="{StaticResource LiquidGlassSurface}" BorderBrush="{StaticResource LiquidGlassBorder}" BorderThickness="1" CornerRadius="18" Padding="14,10" Margin="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Color="#000000" Opacity="0.5" />
        </Border.Effect>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Album Artwork Squircle -->
            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" Background="#1C1C22" BorderBrush="#20FFFFFF" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Path Data="{StaticResource IconLibrary}" Fill="#3F3F46" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding CurrentTrack.CoverPath}" Stretch="UniformToFill" />
                </Grid>
            </Border>

            <!-- Title & Artist -->
            <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='inline Music'}" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="13" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CurrentTrack.Artist, FallbackValue='Mini Player'}" Foreground="#71717A" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Controls (Play/Pause, Next, Close) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Circular Play/Pause Hero Button -->
                <Button Style="{StaticResource HeroPlayButton}" Command="{Binding TogglePlayPauseCommand}" Width="38" Height="38" Margin="4,0" ToolTip="Play / Pause">
                    <Path Width="13" Height="13" Stretch="Uniform">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource IconPlay}" />
                                <Setter Property="Fill" Value="#09090B" />
                                <Setter Property="Margin" Value="1.5,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Data" Value="{StaticResource IconPause}" />
                                        <Setter Property="Margin" Value="0,0,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>

                <!-- Next -->
                <Button Style="{StaticResource GlassIconButton}" Command="{Binding NextCommand}" Width="32" Height="32" Margin="3,0" ToolTip="Next Track">
                    <Path Data="{StaticResource IconNext}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" />
                </Button>

                <!-- Close -->
                <Button Style="{StaticResource GlassIconButton}" Click="Close_Click" Width="28" Height="28" Margin="3,0" ToolTip="Close Mini Player">
                    <Path Data="{StaticResource IconClose}" Fill="#71717A" Width="11" Height="11" Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
