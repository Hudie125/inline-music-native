<UserControl x:Class="InlineMusic.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Search" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" />
            <TextBlock Text="Search local library tracks, artists and albums" FontSize="14" Foreground="#71717A" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Sleek Search Input Field -->
        <Border Grid.Row="1" Style="{StaticResource ModernGlassCard}" Padding="16,10" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="#71717A" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                         FontSize="15" CaretBrush="#FFFFFF" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Search Results List -->
        <Border Grid.Row="2" Style="{StaticResource ModernGlassCard}" Padding="6">
            <ListView ItemsSource="{Binding SearchResults}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,6">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#14FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#22FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#1C1C22" BorderBrush="#1FFFFFFF" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <Path Data="{StaticResource IconLibrary}" Fill="#3F3F46" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Artist}" Foreground="#71717A" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding Album}" Foreground="#71717A" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />

                            <TextBlock Grid.Column="3" Text="{Binding FormattedDuration}" Foreground="#71717A" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Segoe UI Variable, Segoe UI, sans-serif" />

                            <Button Grid.Column="4" Style="{StaticResource GlassIconButton}" Width="32" Height="32" HorizontalAlignment="Right"
                                    Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}" ToolTip="Play">
                                <Path Data="{StaticResource IconPlay}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="1,0,0,0" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>
