<UserControl x:Class="InlineMusic.Views.WaveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="My Wave" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16" />

        <!-- Wave Hero Card -->
        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="32,28" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Endless Personal Radio" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Smart local stream adapted in real-time to your listening patterns, likes, and affinities."
                               FontSize="14" Foreground="#8E8E93" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="520" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh" Command="{Binding RefreshWaveCommand}" Margin="0,0,12,0" Padding="20,10" />
                    <Button Content="▶ Launch Wave" Command="{Binding LaunchWaveCommand}" Background="#FFFFFF" Foreground="#000000" FontWeight="Bold" Padding="24,10" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dynamic Recommendation Queue -->
        <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="8">
            <ListView ItemsSource="{Binding WaveTracks}" Background="Transparent" BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#28282E" ClipToBounds="True">
                                <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="14" />
                                <TextBlock Text="{Binding Artist}" Foreground="#8E8E93" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding Genre}" Foreground="#8E8E93" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding FormattedDuration}" Foreground="#8E8E93" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>
