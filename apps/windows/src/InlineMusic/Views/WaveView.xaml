<UserControl x:Class="InlineMusic.Views.WaveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="My Wave" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" />
            <TextBlock Text="Autonomous local recommendation stream tailored to your listening habits" FontSize="14" Foreground="#71717A" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Wave Hero Card -->
        <Border Grid.Row="1" Style="{StaticResource ModernGlassCard}" Padding="32,26" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="28" Height="28" CornerRadius="8" Background="#26FFFFFF" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconWave}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Endless Personal Radio" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Adapts in real-time to your completed tracks, skipped items, favorites, and time-of-day audio affinities with zero cloud profiling."
                               FontSize="14" Foreground="#A1A1AA" TextWrapping="Wrap" MaxWidth="540" LineHeight="20" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ModernGlassPillButton}" Command="{Binding RefreshWaveCommand}" Margin="0,0,12,0" Padding="18,10">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ModernWhitePillButton}" Command="{Binding LaunchWaveCommand}" Padding="22,10">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlay}" Fill="#09090B" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Launch Wave" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dynamic Recommendation Queue List -->
        <Border Grid.Row="2" Style="{StaticResource ModernGlassCard}" Padding="6">
            <ListView ItemsSource="{Binding WaveTracks}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,6">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#14FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#22FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#1C1C22" BorderBrush="#1FFFFFFF" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <Path Data="{StaticResource IconLibrary}" Fill="#3F3F46" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Artist}" Foreground="#71717A" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#16FFFFFF" CornerRadius="8" Padding="8,4">
                                <TextBlock Text="{Binding Genre, FallbackValue='Music'}" Foreground="#A1A1AA" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </Border>

                            <TextBlock Grid.Column="3" Text="{Binding FormattedDuration}" Foreground="#71717A" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Segoe UI Variable, Segoe UI, sans-serif" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>
